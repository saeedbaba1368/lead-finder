# Copy to .env and adjust. All variables use the APP_ prefix.
APP_NAME=leadfinder
APP_ENV=development        # development | test | production
APP_DEBUG=false
APP_HOST=127.0.0.1
APP_PORT=8000
APP_LOG_LEVEL=INFO         # DEBUG | INFO | WARNING | ERROR | CRITICAL
APP_LOG_JSON=true          # true = JSON lines, false = human-readable
APP_DATABASE_URL=sqlite:///./leadfinder.db   # e.g. postgresql+psycopg://user:pass@host/db
APP_DB_ECHO=false          # log SQL statements

# --- URL policy (Phase 4) ---
APP_URL_MAX_LENGTH=2048                     # reject URLs longer than this (64-65536)
APP_URL_ALLOWED_PORTS=80,443                # comma-separated; * or empty = any port
APP_URL_SUBDOMAIN_MODE=relevant             # exact | www | relevant | all
APP_URL_SCOPE_DOMAINS=                      # extra registered domains treated as in scope (comma-separated)
APP_URL_BLOCKED_DOMAINS=                    # never crawl these domains or their subdomains (comma-separated)
APP_URL_EXTRA_TRACKING_PARAMS=              # extra query params to strip (comma-separated)
APP_URL_EXTRA_PUBLIC_SUFFIXES=              # extra public suffixes for registered-domain logic (comma-separated)
APP_URL_TRAILING_SLASH=strip                # strip | keep
APP_URL_ALLOW_PDF=false                     # treat PDFs as eligible content
APP_URL_ALLOW_PLAIN_TEXT=false              # treat text/plain and .txt as eligible content
APP_URL_SSRF_ALLOW_PRIVATE_NETWORKS=false   # dev/test only; refused when APP_ENV=production; never unblocks cloud metadata
APP_URL_MAX_PATH_DEPTH=12                   # max path segments
APP_URL_MAX_QUERY_PARAMS=12                 # max query parameters
APP_URL_MAX_PAGE_NUMBER=50                  # highest ?page=N / /page/N followed
APP_URL_MAX_QUERY_VARIANTS_PER_PATH=30      # distinct query strings per path per crawl
APP_URL_MAX_CALENDAR_URLS_PER_PATTERN=40    # URLs per calendar-style pattern per crawl
APP_URL_CALENDAR_YEARS_BACK=5               # calendar/archive years older than this are traps
APP_URL_CALENDAR_YEARS_AHEAD=1              # calendar/archive years further ahead are traps

# --- Sitemap discovery (Phase 5) ---
APP_DISCOVERY_TIMEOUT_SECONDS=10            # per-request timeout for robots.txt / sitemap fetches (>0, <=120)
APP_DISCOVERY_MAX_BYTES=5242880             # largest robots.txt / sitemap body accepted (1024-104857600)
APP_DISCOVERY_MAX_REDIRECTS=3               # redirects followed per fetch; every hop is re-validated (0-10)
APP_DISCOVERY_USER_AGENT=leadfinder/0.5 (+sitemap-discovery)   # User-Agent header sent by discovery
APP_DISCOVERY_MAX_DEPTH=5                   # sitemap-index nesting depth; top-level sitemaps are depth 0 (0-20)
APP_DISCOVERY_MAX_SITEMAPS=1000             # sitemap files fetched per discovery run (1-100000)
APP_DISCOVERY_MAX_URLS=100000               # page URLs admitted per discovery run (1-5000000)

# --- HTTP crawler client (Phase 6.1) ---
APP_CRAWLER_CONNECT_TIMEOUT=10              # seconds to establish a connection (>0, <=120)
APP_CRAWLER_READ_TIMEOUT=15                 # seconds to wait for response data (>0, <=300)
APP_CRAWLER_WRITE_TIMEOUT=10                # seconds to send the request (>0, <=120)
APP_CRAWLER_POOL_TIMEOUT=10                 # seconds to wait for a free pooled connection (>0, <=120)
APP_CRAWLER_FOLLOW_REDIRECTS=true           # false = a 3xx is reported, not followed
APP_CRAWLER_MAX_REDIRECTS=5                 # redirect hops followed per fetch (0-20)
APP_CRAWLER_MAX_RESPONSE_BYTES=5242880      # largest body accepted (1024-209715200)
APP_CRAWLER_SUPPORTED_CONTENT_TYPES=text/html,application/xhtml+xml   # comma-separated media types
APP_CRAWLER_ALLOW_MISSING_CONTENT_TYPE=true # accept 2xx responses that send no Content-Type
APP_CRAWLER_USER_AGENT=leadfinder/0.6 (+http-crawler)   # User-Agent header
APP_CRAWLER_MAX_CONNECTIONS=20              # connection pool size (1-1000)
APP_CRAWLER_MAX_KEEPALIVE_CONNECTIONS=10    # idle connections kept for reuse (0-1000)

# --- BFS crawl limits (Phase 6.2) ---
APP_CRAWLER_MAX_PAGES=100                   # pages fetched per crawl, failures included (1-100000)
APP_CRAWLER_MAX_DEPTH=3                     # link depth from the seed; seed = 0 (0-50)

# --- Crawl controls (Phase 6.3.1) ---
APP_CRAWLER_MAX_CRAWL_TIME=0                # max crawl runtime (monotonic clock) in seconds; 0 = no limit (0-86400)
APP_CRAWLER_REQUEST_DELAY=0                 # minimum seconds between request starts; 0 = none (0-3600)
